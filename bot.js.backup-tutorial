  const game = GAME[gameKey];
  const endpoint = gameKey === "TRX" ? "GetTrxGameIssue" : "GetGameIssue";
  const body = {
    typeId: game.typeId,
    language: LANGUAGE,
    random: crypto.randomBytes(16).toString("hex")
  };
  body.signature = generateSignature(body);
  body.timestamp = Math.floor(Date.now() / 1000);

  const r = await session.post(endpoint, body);
  if (r.data?.code !== 0) return null;
  const d = r.data.data || {};
  const period = d.issueNumber || d.predraw?.issueNumber || "";
  return period ? String(period) : null;
}

const MIN_EXACT_MATCHES = 20;

function predict(records, oldN, newN) {
  const history = (Array.isArray(records) ? records : [])
    .map(r => {
      if (typeof r === "number") return Number.isInteger(r) && r >= 0 && r <= 9 ? r : null;
      if (typeof r === "string") {
        const n = Number(r);
        return Number.isInteger(n) && n >= 0 && n <= 9 ? n : null;
      }
      const candidates = [r?.number, r?.result, r?.resultNumber, r?.numberValue, r?.openNumber, r?.openResult];
      for (const x of candidates) {
        const n = Number(x);
        if (Number.isInteger(n) && n >= 0 && n <= 9) return n;
      }
      return null;
    })
    .filter(n => n !== null);

  const total = history.length;

  function calcStats(list) {
    const counts = Array(10).fill(0);
    for (const n of list) {
      if (n >= 0 && n <= 9) counts[n]++;
    }
    const big = counts.slice(5).reduce((a, b) => a + b, 0);
    const small = counts.slice(0, 5).reduce((a, b) => a + b, 0);
    return { counts, total: list.length, big, small };
  }

  // ============================================================
  // FULL DATA + OLD/NEW + EXACT TRANSITION ANALYSIS
  // ============================================================

  const exactResults = [];

  // old -> new -> next
  for (let i = 0; i < history.length - 2; i++) {
    if (history[i] === oldN && history[i + 1] === newN) {
      exactResults.push(history[i + 2]);
    }
  }

  // new -> next
  const afterNew = [];

  for (let i = 0; i < history.length - 1; i++) {
    if (history[i] === newN) {
      afterNew.push(history[i + 1]);
    }
  }

  // old -> next
  const afterOld = [];

  for (let i = 0; i < history.length - 1; i++) {
    if (history[i] === oldN) {
      afterOld.push(history[i + 1]);
    }
  }

  // ------------------------------------------------------------
  // 1. FULL HISTORY
  // ------------------------------------------------------------
  const overall = calcStats(history);

  // ------------------------------------------------------------
  // 2. RECENT HISTORY
  // ------------------------------------------------------------
  const recentSize = Math.min(300, history.length);
  const recentHistory = history.slice(0, recentSize);
  const recentStats = calcStats(recentHistory);

  // ------------------------------------------------------------
  // 3. OLD DIGIT FOLLOW-UP
  // ------------------------------------------------------------
  const oldStats = calcStats(afterOld);

  // ------------------------------------------------------------
  // 4. NEW DIGIT FOLLOW-UP
  // ------------------------------------------------------------
  const newStats = calcStats(afterNew);

  // ------------------------------------------------------------
  // 5. EXACT OLD -> NEW FOLLOW-UP
  // ------------------------------------------------------------
  const exactStats = calcStats(exactResults);

  const bigRate = st =>
    st.total > 0 ? st.big / st.total : 0.5;

  const overallBig = bigRate(overall);
  const recentBig = bigRate(recentStats);
  const oldBig = bigRate(oldStats);
  const newBig = bigRate(newStats);
  const exactBig = bigRate(exactStats);

  // ------------------------------------------------------------
  // SIGNAL WEIGHTS
  //
  // Overall      = 35%
  // Recent       = 25%
  // Old digit    = 10%
  // New digit    = 10%
  // Exact pair   = 20% (only when enough samples exist)
  // ------------------------------------------------------------

  let score =
    (overallBig * 0.35) +
    (recentBig * 0.25) +
    (oldBig * 0.10) +
    (newBig * 0.10);

  let level = 3;

  // Exact old -> new signal is used only when
  // there are enough historical examples.
  if (exactResults.length >= MIN_EXACT_MATCHES) {
    score += exactBig * 0.20;
    level = 1;
  } else {
    // If exact pair sample is too small,
    // redistribute its weight to the more reliable signals.
    score =
      (overallBig * 0.40) +
      (recentBig * 0.30) +
      (oldBig * 0.10) +
      (newBig * 0.20);

    if (afterNew.length >= MIN_EXACT_MATCHES) {
      level = 2;
    }
  }

  let prediction;

  if (score > 0.5) {
    prediction = "BIG";
  } else if (score < 0.5) {
    prediction = "SMALL";
  } else {
    prediction =
      recentStats.big >= recentStats.small
        ? "BIG"
        : "SMALL";
  }

  return {
    prediction,

    level,

    // Statistics are ALWAYS based on the full history.
    stats: overall,

    total,

    // Full dataset used for prediction/statistics.
    matched: overall.total,

    // Number of exact old -> new -> next matches.
    exactMatch: exactResults.length,

    // Extra analysis data for debugging/output if needed.
    signals: {
      overall: {
        total: overall.total,
        big: overall.big,
        small: overall.small,
        bigPercent: +(overallBig * 100).toFixed(2)
      },

      recent: {
        total: recentStats.total,
        big: recentStats.big,
        small: recentStats.small,
        bigPercent: +(recentBig * 100).toFixed(2)
      },

      old: {
        digit: oldN,
        total: oldStats.total,
        big: oldStats.big,
        small: oldStats.small,
        bigPercent: +(oldBig * 100).toFixed(2)
      },

      new: {
        digit: newN,
        total: newStats.total,
        big: newStats.big,
        small: newStats.small,
        bigPercent: +(newBig * 100).toFixed(2)
      },

      exact: {
        pair: `${oldN},${newN}`,
        total: exactStats.total,
        big: exactStats.big,
        small: exactStats.small,
        bigPercent: +(exactBig * 100).toFixed(2)
      },

      score: +(score * 100).toFixed(2)
    }
  };
}

function predictionMessage(gameKey, oldN, newN, pred, nextPeriod, totalData) {
  const game = GAME?.[gameKey] || { name: gameKey };
  const st = pred.stats || { counts: Array(10).fill(0), big: 0, small: 0, total: 0 };
  const total = st.total || 0;
  const pct = n => total > 0 ? ((n / total) * 100).toFixed(2) : "0.00";

  let msg = `${icon("predict")} <b>AI Agent Predictor</b>\n`;
  msg += `================\n`;
  msg += `${icon(gameKey === "WINGO" ? "wingo" : "trx")}<b> 6 Lottery  — ${game.name}</b>\n\n`;
  msg += `${icon("input")} Input old → new: <code>${oldN}, ${newN}</code>\n`;
  msg += `${icon("search")} Lookup: ${oldN},${newN} (exact old→new)\n\n`;
  msg += `${icon("data")} <b>Total Data: ${totalData}</b>\n\n`;
  msg += `${icon("result")} <b>BIG (5–9):</b> ${st.big} (${pct(st.big)}%)\n`;
  msg += `${icon("result")} <b>SMALL (0–4):</b> ${st.small} (${pct(st.small)}%)\n\n`;
  msg += `${icon("stats")} <b>နံပါတ်အလိုက်ရလဒ်များ</b>\n`;

  for (let n = 0; n <= 9; n++) {
    msg += `${n}: ${st.counts[n]} (${pct(st.counts[n])}%)\n`;
  }

  msg += `\n${icon("target")} <b>Prediction: ${pred.prediction}</b>\n`;
  msg += `Level: ${pred.level}\n`;
  msg += `Matched Data: ${pred.matched}\n`;
  msg += `Exact Match: ${pred.exactMatch}\n`;
  msg += `\n${icon("next")} နောက်လာမည့်ပွဲစဉ်: <code>${nextPeriod}</code>\n\n`;
  msg += `Period ပြီးဆုံးပါက WIN သို့မဟုတ် LOSE ကို ကိုယ်တိုင်နှိပ်ပါ။`;

  return msg;
}

let updaterBusy = false;
let collectorSession = null;

async function ensureCollectorSession() {
  if (collectorSession) return collectorSession;
  if (!DATA_PHONE || !DATA_PASSWORD) return null;
  try {
    const r = await login6Lottery(DATA_PHONE, DATA_PASSWORD);
    if (r.ok) {
      collectorSession = r.session;
      console.log("📡 Dedicated 6 Lottery data collector login OK");
      return collectorSession;
    }
  } catch (e) {
    console.error(`[DATA] collector login failed: ${e.message}`);
  }
  return null;
}

async function updateAllHistory() {
  if (updaterBusy) return;
  updaterBusy = true;

  try {
    let session = await ensureCollectorSession();
    if (!session) {
      const active = Object.values(users).find(u => u.sessionToken && u.sessionTokenHeader);
      if (active) {
        session = axios.create({
          baseURL: API_BASE_URL,
          timeout: 15000,
          headers: apiHeaders(active.sessionTokenHeader, active.sessionToken),
          validateStatus: () => true
        });
      }
    }

    if (session) {
      try {
        const wingoRecords = await fetchHistory(session, "WINGO", 100, true);
        if (wingoRecords.length) {
          resultStore.WINGO = wingoRecords.slice(0, WINGO_LIMIT);
          persist();
          console.log(`[DATA] WINGO updated: ${resultStore.WINGO.length}/${WINGO_LIMIT}`);
        }
      } catch (e) {
        console.error(`[DATA] WINGO update failed: ${e.message}`);
      }

      try {
        const trxApiRecords = await fetchTRXApiHistory(session, TRX_LIMIT);

        if (trxApiRecords.length) {
          const parsed = trxApiRecords
            .map(extractResult)
            .filter(Boolean);

          console.log(
            `[TRX API] Parsed ${parsed.length}/${trxApiRecords.length} records`
          );

          if (parsed.length) {
            resultStore.TRX = parsed.slice(0, TRX_LIMIT);
            persist();
            console.log(
              `[DATA] TRX updated: ${resultStore.TRX.length}/${TRX_LIMIT}`
            );
          }
        } else {
          console.log("[TRX API] No records returned");
        }
      } catch (e) {
        console.error(`[DATA] TRX update failed: ${e.message}`);
      }
    }
  } finally {
    updaterBusy = false;
  }
}

