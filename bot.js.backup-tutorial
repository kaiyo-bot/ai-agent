bot.on("callback_query", async ctx => {
  const data = ctx.callbackQuery?.data || "";
  
  if (data.startsWith("emoji_select:")) {
    if (!isAdmin(ctx.from.id)) return ctx.answerCbQuery("Admin only!");
    const key = data.split(":")[1];
    const u = users[String(ctx.from.id)] || (users[String(ctx.from.id)] = { id: String(ctx.from.id) });
    u.state = `ADMIN_EMOJI_ID:${key}`;
    persist();
    await ctx.answerCbQuery();
    return reply(ctx, `${icon("input")} <b>${key}</b> အတွက် Custom Emoji ID (နံပါတ်သီးသန့်) ပို့ပေးပါ။`);
  }

  const m = data.match(/^pred_(win|lose):(.+)$/);
  if (!m) return ctx.answerCbQuery();
  const predId = m[2];
  const p = predictions[predId];
  if (!p) return ctx.answerCbQuery("Prediction not found.", { show_alert: true });

  if (String(ctx.from.id) !== String(p.telegramId)) {
    return ctx.answerCbQuery("ဒီ Prediction ကို သင်မဖန်တီးထားပါ။", { show_alert: true });
  }
  if (p.status !== "PENDING") {
    return ctx.answerCbQuery("ပြီးသား မှတ်တမ်းဖြစ်ပါတယ်။", { show_alert: true });
  }

  const u = users[String(ctx.from.id)];
  let result = null;
  try {
    if (u?.sessionToken) {
      const session = axios.create({
        baseURL: API_BASE_URL,
        timeout: 15000,
        headers: apiHeaders(u.sessionTokenHeader, u.sessionToken),
        validateStatus: () => true
      });
      const records = await fetchHistory(session, p.game, 100, false);
      const found = records.find(x => String(x.period) === String(p.predictedPeriod));
      if (found) result = found;
    }
  } catch {}

  const status = m[1] === "win" ? "WIN" : "LOSE";
  p.status = status;
  p.resolvedAt = new Date().toISOString();
  p.result = result;

  if (u) {
    u.state = "PREDICT_INPUT";
    u.selectedGame = p.game;
  }
  persist();

  const resultNumber = result?.number ?? "N/A";
  await ctx.answerCbQuery(status);
  await reply(ctx, 
    `${status === "WIN" ? icon("win") : icon("lose")} <b>${status} မှတ်တင်ပြီးပါပြီ။</b>\n` +
    `Period: \`${result?.period || p.predictedPeriod}\`\n` +
    `Result Number: <b>${resultNumber}</b>\n\n` +
    `နောက်ပွဲအတွက် နံပါတ်နှစ်လုံးကို old → new <code>0,2</code> ပုံစံဖြင့် ထည့်ပါ။`,
    mainKeyboard(true, isAdmin(ctx.from.id))
  );
});

