  msg += `Period ပြီးဆုံးပါက WIN သို့မဟုတ် LOSE ကို ကိုယ်တိုင်နှိပ်ပါ။`;

  return msg;
}

async function updateGameHistory(gameKey) {
  const active = Object.values(users).filter(
    u => u.sessionToken && u.sessionTokenHeader
  );

  if (!active.length && !collectorSession) return;

  let session = collectorSession;

  if (!session) {
    const u = active[0];

    session = axios.create({
      baseURL: API_BASE_URL,
      timeout: 10000,
      headers: apiHeaders(u.sessionTokenHeader, u.sessionToken),
      validateStatus: () => true
    });
  }

  try {
    // Only newest 100 records on every auto update.
    const latest = await fetchHistory(session, gameKey, 100, false);

    if (!latest.length) return;

    const limit = gameKey === "WINGO"
      ? WINGO_LIMIT
      : TRX_LIMIT;

    const old = Array.isArray(resultStore[gameKey])
      ? resultStore[gameKey]
      : [];

    // Newest first.
    const merged = [...latest, ...old];

    const seen = new Set();
    const unique = [];

    for (const r of merged) {
      if (!r || !r.period || !Number.isInteger(r.number)) continue;

      const key = String(r.period);

      if (seen.has(key)) continue;

      seen.add(key);
      unique.push(r);

      if (unique.length >= limit) break;
    }

    resultStore[gameKey] = unique;

    persist();

    console.log(
      `[DATA] ${gameKey} updated: ${unique.length}/${limit}`
    );

  } catch (e) {
    console.error(
      `[DATA] ${gameKey} update failed: ${e.message}`
    );
  }
}

