function generateSignature(data) {
  const filtered = {};
  Object.keys(data).sort().forEach(k => {
    if (k === "signature" || k === "track" || k === "xosoBettingData") return;
    const v = data[k];
    if (v !== null && v !== "") filtered[k] = v === 0 ? 0 : v;
  });
  return crypto.createHash("md5").update(JSON.stringify(filtered)).digest("hex").toUpperCase();
}

async function postPublic(endpoint, body) {
  const payload = { ...body };
  payload.signature = generateSignature(payload);
  payload.timestamp = Math.floor(Date.now() / 1000);
  const res = await axios.post(API_BASE_URL + endpoint, payload, {
    headers: apiHeaders("", ""),
    timeout: 15000,
    validateStatus: () => true
  });
  return res.data;
}

async function login6Lottery(phone, password) {
  const loginData = {
    username: COUNTRY_CODE + String(phone).replace(/\D/g, ""),
    pwd: String(password),
    phonetype: 1,
    logintype: "mobile",
    packId: "",
    deviceId: DEVICE_ID,
    language: LANGUAGE,
    random: crypto.randomBytes(16).toString("hex")
  };
  loginData.signature = generateSignature(loginData);
  loginData.timestamp = Math.floor(Date.now() / 1000);

  const response = await axios.post(API_BASE_URL + "Login", loginData, {
    headers: {
      "Content-Type": "application/json;charset=UTF-8",
      "Ar-Origin": "https://6win598.com",
      Origin: "https://6win598.com",
      Referer: "https://6win598.com/",
      "User-Agent": "Mozilla/5.0 (Linux; Android 16) AppleWebKit/537.36 Chrome/140 Mobile Safari/537.36"
    },
    timeout: 15000,
    validateStatus: () => true
  });
  const res = response.data || {};
  if (res.code !== 0 || !res.data) return { ok: false, message: res.msg || "Login failed" };

  const tokenHeader = res.data.tokenHeader || "Bearer ";
  const token = res.data.token || "";
  if (!token) return { ok: false, message: "Login succeeded but no token was returned." };

  const session = axios.create({
    baseURL: API_BASE_URL,
    timeout: 15000,
    headers: apiHeaders(tokenHeader, token),
    validateStatus: () => true
  });

  const userInfo = await getUserInfo(session);
  if (!userInfo?.userId) return { ok: false, message: "Could not retrieve Game ID after login." };

  return { ok: true, session, tokenHeader, token, userInfo };
}

async function getUserInfo(session) {
  const body = {
    language: LANGUAGE,
    random: crypto.randomBytes(16).toString("hex")
  };
  body.signature = generateSignature(body);
  body.timestamp = Math.floor(Date.now() / 1000);
  const r = await session.post("GetUserInfo", body);
  if (r.data?.code === 0 && r.data?.data) return r.data.data;
  return null;
}

const GAME = {
  WINGO: { key: "WINGO", name: "WINGO 1MIN", typeId: 1 },
  TRX: { key: "TRX", name: "TRX", typeId: 13 }
};

function extractResult(item) {
  const period = String(item?.issueNumber ?? item?.period ?? item?.issue ?? "");
  const raw = item?.number ?? item?.result ?? item?.num ?? item?.winNumber ?? "";
  const number = Number(String(raw).replace(/[^\d]/g, "").slice(-1));
  if (!period || !Number.isInteger(number) || number < 0 || number > 9) return null;
  return { period, number };
}

async function fetchHistory(session, gameKey, pageSize = 100, full = true) {
  const game = GAME[gameKey];
  const limit = gameKey === "WINGO" ? WINGO_LIMIT : TRX_LIMIT;

  const out = [];
  const seen = new Set();

  // Full load = up to 1700 records.
  // Update load = only the newest page, then merge with stored data.
  const maxPages = full
    ? Math.ceil(limit / pageSize) + 3
    : 1;

  for (let page = 1; page <= maxPages && out.length < limit; page++) {
    const body = {
      pageSize,
      pageNo: page,
      typeId: game.typeId,
      language: LANGUAGE,
      random: crypto.randomBytes(16).toString("hex")
    };

    body.signature = generateSignature(body);
    body.timestamp = Math.floor(Date.now() / 1000);

    // IMPORTANT:
    // WINGO and TRX both use GetNoaverageEmerdList.
    // TRX is selected by typeId = 13.
    const r = await session.post("GetNoaverageEmerdList", body);

    if (r.data?.code !== 0) {
      console.error(
        `[DATA] ${gameKey} API error: ${r.data?.msg || "unknown"}`
      );
      break;
    }

    const list =
      r.data?.data?.list ||
      r.data?.data?.records ||
      [];

    if (!Array.isArray(list) || list.length === 0) {
      console.log(`[DATA] ${gameKey}: page ${page} empty`);
      break;
    }

    let added = 0;

    for (const item of list) {
      const x = extractResult(item);

      if (x && x.period && !seen.has(String(x.period))) {
        seen.add(String(x.period));
        out.push(x);
        added++;
      }

      if (out.length >= limit) break;
    }

    console.log(
      `[DATA] ${gameKey}: page ${page} +${added}, total=${out.length}/${limit}`
    );

    if (added === 0 || list.length < pageSize) break;
  }

  return out;
}

async function fetchLatestIssue(session, gameKey) {
  const game = GAME[gameKey];
  const endpoint = gameKey === "TRX" ? "GetTrxGameIssue" : "GetGameIssue";
  const body = {
    typeId: game.typeId,
    language: LANGUAGE,
    random: crypto.randomBytes(16).toString("hex")
  };
  body.signature = generateSignature(body);
  body.timestamp = Math.floor(Date.now() / 1000);

  const r = await session.post(endpoint, body);
  if (r.data?.code !== 0) return null;
  const d = r.data.data || {};
  const period = d.issueNumber || d.predraw?.issueNumber || "";
  return period ? String(period) : null;
}

