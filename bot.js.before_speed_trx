    persist();

    await reply(ctx, 
      predictionMessage(gameKey, oldN, newN, pred, nextPeriod, records.length),
      winLoseKeyboard(predId)
    );
    return;
  }

  // ----------------------------------------------------------
  // ADMIN CUSTOM EMOJI ID INPUT
  // ----------------------------------------------------------
  if (
    isAdmin(id) &&
    u.state &&
    u.state.startsWith("ADMIN_EMOJI_ID:")
  ) {
    const key = u.state.split(":")[1];
    const emojiId = text.replace(/\\s+/g, "");

    if (!validCustomEmojiId(emojiId)) {
      return reply(
        ctx,
        `${icon("error")} Emoji ID မမှန်ပါ။\\n\\n` +
        `နံပါတ်သီးသန့် ထည့်ပါ။\\n` +
        `ဥပမာ: <code>5226431245918942763</code>`
      );
    }

    CUST_ID[key] = emojiId;

    saveJson(FILES.emojis, CUST_ID);

    u.state = null;
    persist();

    return reply(
      ctx,
      `${icon("success")} <b>${escapeHtml(key)}</b> Custom Emoji ID သိမ်းပြီးပါပြီ။\\n` +
      `ID: <code>${escapeHtml(emojiId)}</code>\\n\\n` +
      `Bot restart လုပ်လည်း မပျက်ပါ။`,
      adminKeyboard()
    );
  }

  if (isAdmin(id) && u.state === "ADMIN_ADD") {
    const target = text.replace(/\D/g, "");
    if (!target) return reply(ctx, `${icon("error")} Valid Telegram User ID ထည့်ပါ။`, adminKeyboard());
    allowedIds.add(target);
    u.state = null;
    persist();
    return reply(ctx, `${icon("success")} User ထည့်ပြီးပါပြီ။\nID: \`${target}\``, adminKeyboard());
  }

  if (isAdmin(id) && u.state === "ADMIN_REMOVE") {
    const target = text.replace(/\D/g, "");
    if (!target) return reply(ctx, `${icon("error")} Valid Telegram User ID ထည့်ပါ။`, adminKeyboard());
    const existed = allowedIds.delete(target);
    u.state = null;
    persist();
    return reply(ctx, `${existed ? icon("success") + " User ဖယ်ပြီးပါပြီ။" : icon("error") + " ဒီ ID မရှိပါ။"}\nID: \`${target}\``, adminKeyboard());
  }

  if (isAdmin(id) && u.state === "ADMIN_BROADCAST") {
    u.state = null;
    let ok = 0, fail = 0;
    for (const target of [...allowedIds]) {
      try {
        await sendMessage(target, `${icon("broadcast")} ${escapeHtml(text)}`);
        ok++;
      } catch { fail++; }
      await new Promise(r => setTimeout(r, 80));
    }
    persist();
    return reply(ctx, `${icon("success")} Broadcast ပြီးပါပြီ။\n\n✅ Sent: ${ok}\n❌ Failed: ${fail}`, adminKeyboard());
  }

  // If a user types plain text after selecting a game, don't accidentally mix games.
  if (isAllowed(id) && !u.state) {
    return reply(ctx, `${icon("input")} Predict လုပ်ရန် <b>Predict</b> ကိုနှိပ်ပြီး ` +
      `နောက်ဆုံး result နှစ်လုံးကို old → new <code>0,2</code> ပုံစံဖြင့် ထည့်ပါ။`,
      mainKeyboard(true, isAdmin(id))
    );
  }
});

bot.command("id", ctx => reply(ctx, `🆔 Telegram ID: \`${ctx.from.id}\``));

process.once("SIGINT", () => { persist(); bot.stop("SIGINT"); });
process.once("SIGTERM", () => { persist(); bot.stop("SIGTERM"); });

bot.launch().then(() => {
  console.log("🤖 6 Lottery Predictor Bot started.");
  console.log(`📡 API: ${API_BASE_URL}`);
  console.log(`🟢 Wingo limit: ${WINGO_LIMIT}`);
  console.log(`🔴 TRX limit: ${TRX_LIMIT}`);

  setInterval(
    () => updateAllHistory().catch(e => console.error(e.message)),
    UPDATE_INTERVAL_MS
  );

  updateAllHistory().catch(() => {});
}).catch(err => {
  console.error("Bot launch failed:", err);
  process.exit(1);
});
