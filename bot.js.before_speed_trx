function statsFor(records) {
  const counts = Array(10).fill(0);
  for (const r of records) counts[r.number]++;
  const total = records.length || 1;
  const pct = counts.map(c => c * 100 / total);
  const bigCount = counts.slice(5).reduce((a,b) => a+b, 0);
  const smallCount = counts.slice(0,5).reduce((a,b) => a+b, 0);
  return { counts, pct, total: records.length, bigCount, smallCount,
    bigPct: bigCount * 100 / total, smallPct: smallCount * 100 / total };
}

/*
  Prediction engine:
  Level 1: exact old -> new transition. Scan the FULL stored history.
  Level 2: if exact matches are below MIN_EXACT_MATCHES, use every occurrence
           where the new digit equals "new", then inspect the following result.
  Level 3: use the FULL stored history.

  In all levels, the output includes 0-9 percentages and BIG/SMALL percentages.
  This is statistical analysis, not a guarantee of the next outcome.
*/
const MIN_EXACT_MATCHES = 20;



function predict(records, oldN, newN) {
  /*
    Prediction Engine V2

    Level 1:
      Exact old -> new transition

    Level 2:
      new -> following result

    Level 3:
      Full history + recent history + digit distribution

    IMPORTANT:
      Level 3 က overall BIG/SMALL count တစ်ခုတည်းနဲ့
      prediction မဆုံးဖြတ်တော့ပါ။
  */

  const history = (Array.isArray(records) ? records : [])
    .map(r => {
      if (typeof r === "number") {
        return Number.isInteger(r) && r >= 0 && r <= 9 ? r : null;
      }

      if (typeof r === "string") {
        const n = Number(r);
        return Number.isInteger(n) && n >= 0 && n <= 9 ? n : null;
      }

      const candidates = [
        r?.number,
        r?.result,
        r?.resultNumber,
        r?.numberValue,
        r?.openNumber,
        r?.openResult
      ];

      for (const x of candidates) {
        const n = Number(x);
        if (Number.isInteger(n) && n >= 0 && n <= 9) {
          return n;
        }
      }

      return null;
    })
    .filter(n => n !== null);

  const total = history.length;

  function calcStats(list) {
    const counts = Array(10).fill(0);

    for (const n of list) {
      if (n >= 0 && n <= 9) {
        counts[n]++;
      }
    }

    const big = counts.slice(5).reduce((a, b) => a + b, 0);
    const small = counts.slice(0, 5).reduce((a, b) => a + b, 0);

    const pct = counts.map(n =>
      list.length
        ? Number(((n * 100) / list.length).toFixed(2))
        : 0
    );

    return {
      counts,
      pct,
      total: list.length,
      big,
      small,
      bigPct: list.length
        ? Number(((big * 100) / list.length).toFixed(2))
        : 0,
      smallPct: list.length
        ? Number(((small * 100) / list.length).toFixed(2))
        : 0
    };
  }

  // ----------------------------------------------------------
  // LEVEL 1 — Exact old -> new
  // ----------------------------------------------------------

  const exactResults = [];

  for (let i = 0; i < history.length - 2; i++) {
    if (history[i] === oldN && history[i + 1] === newN) {
      exactResults.push(history[i + 2]);
    }
  }

  /*
    Exact match ရှိတာကို အသုံးချမယ်။
    20 ခုအောက်ဆို Level 2 သွားမယ်။
  */
  if (exactResults.length >= MIN_EXACT_MATCHES) {
    const st = calcStats(exactResults);

    return {
      prediction: st.big > st.small ? "BIG" : "SMALL",
      level: 1,
      matched: exactResults.length,
      exactMatch: exactResults.length,
      stats: st,
      total
    };
  }

  // ----------------------------------------------------------
  // LEVEL 2 — new -> next result
  // ----------------------------------------------------------

  const afterNew = [];

  for (let i = 0; i < history.length - 1; i++) {
    if (history[i] === newN) {
      afterNew.push(history[i + 1]);
    }
  }

  if (afterNew.length >= MIN_EXACT_MATCHES) {
    const st = calcStats(afterNew);

    return {
      prediction: st.big > st.small ? "BIG" : "SMALL",
      level: 2,
      matched: afterNew.length,
      exactMatch: exactResults.length,
      stats: st,
      total
    };
  }

  // ----------------------------------------------------------
  // LEVEL 3 — Full history model
  // ----------------------------------------------------------

  const overall = calcStats(history);

  /*
    Recent window:
    နောက်ဆုံး 300 records ကို ပိုအလေးပေးမယ်။
  */
  const recentSize = Math.min(300, history.length);
  const recent = history.slice(0, recentSize);
  const recentStats = calcStats(recent);

  /*
    Input digit တစ်လုံးချင်းစီရဲ့ tendency
  */
  const oldOccurrences = [];
  const newOccurrences = [];

  for (let i = 0; i < history.length - 1; i++) {
    if (history[i] === oldN) {
      oldOccurrences.push(history[i + 1]);
    }

    if (history[i] === newN) {
      newOccurrences.push(history[i + 1]);
    }
  }

  const oldStats = calcStats(oldOccurrences);
  const newStats = calcStats(newOccurrences);

  /*
    Weighted score

    Overall     = 30%
    Recent      = 40%
    new->next   = 20%
    old->next   = 10%

    ဒီနည်းနဲ့ 1700 records ကို အပြည့်အသုံးပြုပြီး
    recent/input-specific tendency ကိုလည်း ထည့်တွက်မယ်။
  */

  const overallBig = overall.total
    ? overall.big / overall.total
    : 0.5;

  const recentBig = recentStats.total
    ? recentStats.big / recentStats.total
    : 0.5;

  const newBig = newStats.total
    ? newStats.big / newStats.total
    : 0.5;

  const oldBig = oldStats.total
    ? oldStats.big / oldStats.total
    : 0.5;

  const score =
    (overallBig * 0.30) +
    (recentBig * 0.40) +
    (newBig * 0.20) +
    (oldBig * 0.10);

  /*
    Score >= 0.50 => BIG
    Score <  0.50 => SMALL

    Exactly 50% ဖြစ်ရင် recent digit distribution ကို
    tie-breaker အဖြစ်သုံးမယ်။
  */

  let prediction;

  if (score > 0.5) {
    prediction = "BIG";
  } else if (score < 0.5) {
    prediction = "SMALL";
  } else {
    prediction =
      recentStats.big > recentStats.small
        ? "BIG"
        : "SMALL";
  }

  /*
    Level 3 မှာ output statistics ကို 1700 records
    အားလုံးအပေါ်မှာ ပြမယ်။
  */

  return {
    prediction,
    level: 3,
    matched: total,
    exactMatch: exactResults.length,
    stats: overall,

    // Debug / analysis values
    model: {
      score: Number((score * 100).toFixed(2)),
      overallBigPct: overall.bigPct,
      recentBigPct: recentStats.bigPct,
      newBigPct: newStats.bigPct,
      oldBigPct: oldStats.bigPct,
      recentCount: recentStats.total,
      newCount: newStats.total,
      oldCount: oldStats.total
    },

    total
  };
}



function fmtPct(x) { return `${x.toFixed(2)}%`; }


function predictionMessage(gameKey, oldN, newN, pred, nextPeriod, totalData) {
  const game = GAME?.[gameKey] || {
    name: gameKey
  };

  const st = pred.stats || {
    counts: Array(10).fill(0),
    big: 0,
    small: 0,
    total: 0
  };

  const total = st.total || 0;

  const pct = n =>
    total > 0 ? ((n / total) * 100).toFixed(2) : "0.00";

  const bigPct = pct(st.big);
  const smallPct = pct(st.small);

  let msg = `${icon("predict")} <b>AI Agent Predictor</b>\n`;
  msg += `================\n`;
  msg += `${icon(gameKey === "WINGO" ? "wingo" : "trx")}<b>777BIGWIN — ${game.name}</b>\n\n`;

  msg += `${icon("input")} Input old → new: <code>${oldN}, ${newN}</code>\n`;
  msg += `${icon("search")} Lookup: ${oldN},${newN} (exact old→new)\n\n`;

  msg += `${icon("data")} <b>Total Data: ${totalData}</b>\n\n`;

  msg += `${icon("result")} <b>BIG (5–9):</b> ${st.big} (${bigPct}%)\n`;
  msg += `${icon("result")} <b>SMALL (0–4):</b> ${st.small} (${smallPct}%)\n\n`;

  msg += `${icon("stats")} <b>နံပါတ်အလိုက်ရလဒ်များ</b>\n`;

  for (let n = 0; n <= 9; n++) {
    msg += `${n}: ${st.counts[n]} (${pct(st.counts[n])}%)\n`;
  }

  msg += `\n${icon("target")} <b>Prediction: ${pred.prediction}</b>\n`;
  msg += `Level: ${pred.level}\n`;
  msg += `Matched Data: ${pred.matched}\n`;
  msg += `Exact Match: ${pred.exactMatch}\n`;

