};

function extractResult(item) {
  const period = String(item?.issueNumber ?? item?.period ?? item?.issue ?? "");
  const raw = item?.number ?? item?.result ?? item?.num ?? item?.winNumber ?? "";
  const number = Number(String(raw).replace(/[^\d]/g, "").slice(-1));
  if (!period || !Number.isInteger(number) || number < 0 || number > 9) return null;
  return { period, number };
}

async function fetchHistory(session, gameKey, pageSize = 100) {
  const game = GAME[gameKey];
  const out = [];
  const seen = new Set();
  const maxPages = Math.ceil((gameKey === "WINGO" ? WINGO_LIMIT : TRX_LIMIT) / pageSize) + 3;

  for (let page = 1; page <= maxPages && out.length < (gameKey === "WINGO" ? WINGO_LIMIT : TRX_LIMIT); page++) {
    const body = {
      pageSize,
      pageNo: page,
      typeId: game.typeId,
      language: LANGUAGE,
      random: crypto.randomBytes(16).toString("hex")
    };
    body.signature = generateSignature(body);
    body.timestamp = Math.floor(Date.now() / 1000);

    const r = await session.post("GetNoaverageEmerdList", body);
    const list = r.data?.data?.list;
    if (!Array.isArray(list) || list.length === 0) break;

    let added = 0;
    for (const item of list) {
      const x = extractResult(item);
      if (x && !seen.has(x.period)) {
        seen.add(x.period);
        out.push(x);
        added++;
      }
    }
    if (added === 0 || list.length < pageSize) break;
  }

  return out;
}

async function fetchLatestIssue(session, gameKey) {
  const game = GAME[gameKey];
  const endpoint = gameKey === "TRX" ? "GetTrxGameIssue" : "GetGameIssue";
  const body = {
    typeId: game.typeId,
    language: LANGUAGE,
    random: crypto.randomBytes(16).toString("hex")
  };
  body.signature = generateSignature(body);
  body.timestamp = Math.floor(Date.now() / 1000);

  const r = await session.post(endpoint, body);
  if (r.data?.code !== 0) return null;
  const d = r.data.data || {};
  const period = d.issueNumber || d.predraw?.issueNumber || "";
  return period ? String(period) : null;
}

function numberBS(n) { return n >= 5 ? "BIG" : "SMALL"; }

function statsFor(records) {
  const counts = Array(10).fill(0);
  for (const r of records) counts[r.number]++;
  const total = records.length || 1;
  const pct = counts.map(c => c * 100 / total);
  const bigCount = counts.slice(5).reduce((a,b) => a+b, 0);
  const smallCount = counts.slice(0,5).reduce((a,b) => a+b, 0);
  return { counts, pct, total: records.length, bigCount, smallCount,
    bigPct: bigCount * 100 / total, smallPct: smallCount * 100 / total };
}

/*
  Prediction engine:
  Level 1: exact old -> new transition. Scan the FULL stored history.
  Level 2: if exact matches are below MIN_EXACT_MATCHES, use every occurrence
           where the new digit equals "new", then inspect the following result.
  Level 3: use the FULL stored history.

  In all levels, the output includes 0-9 percentages and BIG/SMALL percentages.
  This is statistical analysis, not a guarantee of the next outcome.
*/
const MIN_EXACT_MATCHES = 20;


function predict(records, oldN, newN) {
  const MIN_MATCHED = Math.min(
    1500,
    Math.max(1, Number(process.env.MIN_PREDICT_MATCHED || 1500))
  );

  // Normalize history
  const history = (Array.isArray(records) ? records : [])
    .map(r => {
      if (typeof r === "number") return r;
      if (typeof r === "string") {
        const n = Number(r);
        return Number.isInteger(n) && n >= 0 && n <= 9 ? n : null;
      }

      const candidates = [
        r?.number,
        r?.result,
        r?.resultNumber,
        r?.numberValue,
        r?.openNumber,
        r?.openResult
      ];

      for (const x of candidates) {
        const n = Number(x);
        if (Number.isInteger(n) && n >= 0 && n <= 9) return n;
      }

      return null;
    })
    .filter(n => n !== null);

  const total = history.length;

  // ----------------------------------------------------------
  // Count helper
  // ----------------------------------------------------------
  function stats(list) {
    const counts = Array(10).fill(0);

    for (const n of list) {
      if (n >= 0 && n <= 9) counts[n]++;
    }

    const big = counts.slice(5).reduce((a, b) => a + b, 0);
    const small = counts.slice(0, 5).reduce((a, b) => a + b, 0);

    return {
      counts,
      big,
      small,
      total: list.length
    };
  }

  // ----------------------------------------------------------
  // LEVEL 1
  // Exact old -> new transition
  // ----------------------------------------------------------
  const exact = [];

  for (let i = 0; i < history.length - 2; i++) {
    if (history[i] === oldN && history[i + 1] === newN) {
      exact.push(history[i + 2]);
    }
  }

  if (exact.length >= MIN_MATCHED) {
    const st = stats(exact);
    const prediction = st.big >= st.small ? "BIG" : "SMALL";

    return {
      prediction,
      level: 1,
      matched: exact.length,
      exactMatch: exact.length,
      stats: st,
      total
    };
  }

  // ----------------------------------------------------------
  // LEVEL 2
  // Look at what normally follows the NEW number
  // ----------------------------------------------------------
  const afterNew = [];

  for (let i = 0; i < history.length - 1; i++) {
    if (history[i] === newN) {
      afterNew.push(history[i + 1]);
    }
  }

  if (afterNew.length >= MIN_MATCHED) {
    const st = stats(afterNew);
    const prediction = st.big >= st.small ? "BIG" : "SMALL";

    return {
      prediction,
      level: 2,
      matched: afterNew.length,
      exactMatch: exact.length,
      stats: st,
      total
    };
  }

  // ----------------------------------------------------------
  // LEVEL 3
  // Full history / overall statistics
  // ----------------------------------------------------------
  const overall = stats(history);
  const prediction =
    overall.big >= overall.small ? "BIG" : "SMALL";

  return {
    prediction,
    level: 3,
    matched: overall.total,
    exactMatch: exact.length,
    stats: overall,
    total
  };
}


