// For Telegram text, if a custom emoji ID is supplied we use the tg-emoji HTML entity.
// For Reply/Inline buttons, Telegram clients/API versions may not support icon_custom_emoji_id
// on every keyboard type, so labels retain a Unicode fallback and never break when IDs are blank.
function fallbackIcon(key) { return EMOJI[key] || ""; }
function htmlIcon(key, fallback) {
  const id = CUST_ID[key];
  const alt = fallback || fallbackIcon(key);
  return id ? `<tg-emoji emoji-id="${escapeHtml(String(id))}">${escapeHtml(alt)}</tg-emoji>` : alt;
}


function customEmoji(key, fallback = "") {
  const raw = CUST_ID[key];
  const value = raw ? String(raw).trim() : "";

  if (/^\d+$/.test(value)) {
    return `<tg-emoji emoji-id="${value}">${fallback}</tg-emoji>`;
  }

  return value || fallback;
}


function icon(key) {
  const raw = CUST_ID[key];
  const value = raw ? String(raw).trim() : "";

  // .env ထဲမှာ Custom Emoji ID (နံပါတ်) ထည့်ထားရင်
  // ID ကို text အဖြစ် မပြပါ။
  if (/^\d+$/.test(value)) {
    return "";
  }

  // ID မထည့်ရသေးရင် .env ထဲက မူရင်း Unicode Emoji ကိုပြပါ။
  return value;
}
function escapeHtml(s) {
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
function mdEscape(s) {
  return String(s).replace(/([_*[\]()~`>#+\-=|{}.!\\])/g, "\\$1");
}
