async function updateAllHistory() {
  if (updaterBusy) return;
  updaterBusy = true;
  try {
    let session = await ensureCollectorSession();
    if (!session) {
      const active = Object.values(users).find(u => u.sessionToken && u.sessionTokenHeader);
      if (active) {
        session = axios.create({
          baseURL: API_BASE_URL, timeout: 15000,
          headers: apiHeaders(active.sessionTokenHeader, active.sessionToken),
          validateStatus: () => true
        });
      }
    }
    if (!session) return;
    for (const gameKey of ["WINGO", "TRX"]) {
      try {
        const records = await fetchHistory(session, gameKey, 100);
        if (records.length) {
          const limit = gameKey === "WINGO" ? WINGO_LIMIT : TRX_LIMIT;
          resultStore[gameKey] = records.slice(0, limit);
          persist();
        }
      } catch (e) {
        console.error(`[DATA] ${gameKey} update failed: ${e.message}`);
      }
    }
  } finally {
    updaterBusy = false;
  }
}

