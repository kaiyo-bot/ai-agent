bot.on("callback_query", async ctx => {
  const data = ctx.callbackQuery?.data || "";
  const m = data.match(/^pred_(win|lose):(.+)$/);
  if (!m) return ctx.answerCbQuery();
  const predId = m[2];
  const p = predictions[predId];
  if (!p) return ctx.answerCbQuery("Prediction not found.", { show_alert: true });

  // Only the user who made the prediction may mark it.
  if (String(ctx.from.id) !== String(p.telegramId)) {
    return ctx.answerCbQuery("ဒီ Prediction ကို သင်မဖန်တီးထားပါ။", { show_alert: true });
  }
  if (p.status !== "PENDING") {
    return ctx.answerCbQuery("ပြီးသား မှတ်တမ်းဖြစ်ပါတယ်။", { show_alert: true });
  }

  const game = GAME[p.game];
  const u = users[String(ctx.from.id)];
  let result = null;
  try {
    if (u?.sessionToken) {
      const session = axios.create({
        baseURL: API_BASE_URL,
        timeout: 15000,
        headers: apiHeaders(u.sessionTokenHeader, u.sessionToken),
        validateStatus: () => true
      });
      const records = await fetchHistory(session, p.game, 100);
      const found = records.find(x => x.period === p.predictedPeriod);
      if (found) result = found;
      if (records.length) resultStore[p.game] = records.slice(0, p.game === "WINGO" ? WINGO_LIMIT : TRX_LIMIT);
    }
  } catch {}
  persist();

  const status = m[1] === "win" ? "WIN" : "LOSE";
  p.status = status;
  p.resolvedAt = new Date().toISOString();
  p.result = result;
  persist();

  const resultNumber = result?.number ?? "N/A";
  await ctx.answerCbQuery(status);
  await reply(ctx, 
    `${status === "WIN" ? icon("win") : icon("lose")} <b>${status} မှတ်တင်ပြီးပါပြီ။</b>\n` +
    `Period: \`${result?.period || p.predictedPeriod}\`\n` +
    `Result Number: <b>${resultNumber}</b>\n\n` +
    `နောက်ပွဲအတွက် နံပါတ်နှစ်လုံးကို old → new <code>0,2</code> ပုံစံဖြင့် ထည့်ပါ။`,
    mainKeyboard(true, isAdmin(ctx.from.id))
  );
});

bot.on("text", async ctx => {
  const id = String(ctx.from.id);
  const text = ctx.message.text.trim();
  const u = users[id] || (users[id] = { id, state: null, selectedGame: null });

  if (text.startsWith("/")) return;

  if (u.state === "LOGIN_PHONE") {
    u.pendingPhone = text.replace(/\D/g, "");
    u.state = "LOGIN_PASSWORD";
    persist();
    return reply(ctx, `${icon("input")} Password ထည့်ပါ။`);
  }

  if (u.state === "LOGIN_PASSWORD") {
    const phone = u.pendingPhone || "";
    const password = text;
    await reply(ctx, `${icon("loading")} 6 Lottery Login စစ်ဆေးနေပါသည်...`);
    try {
      const result = await login6Lottery(phone, password);
      if (!result.ok) {
        u.state = "LOGIN_PHONE";
        delete u.pendingPhone;
        persist();
        return reply(ctx, `${icon("error")} Login မအောင်မြင်ပါ။\n${result.message}`);
      }
      const gameId = String(result.userInfo.userId);
      if (!allowedIds.has(gameId) && !isAdmin(id)) {
        u.state = null;
        delete u.pendingPhone;
        persist();
        return reply(ctx, `${icon("error")} အသုံးပြုခွင့်မရှိပါ။\n\nGame ID: \`${gameId}\`\nAdmin ထံဆက်သွယ်ပါ ${ADMIN_USERNAME}`, mainKeyboard(false, false));
      }
      u.sessionToken = result.token;
      u.sessionTokenHeader = result.tokenHeader;
      u.gameId = gameId;
      u.phone = phone;
      u.state = null;
      persist();
      // Refresh both datasets immediately after login.
      try {
        const session = result.session;
        const [w, t] = await Promise.all([
          fetchHistory(session, "WINGO", 100),
          fetchHistory(session, "TRX", 100)
        ]);
        if (w.length) resultStore.WINGO = w.slice(0, WINGO_LIMIT);
        if (t.length) resultStore.TRX = t.slice(0, TRX_LIMIT);
        persist();
      } catch {}
      return reply(ctx, `${icon("success")} Login အောင်မြင်ပါပြီ။\nGame ID: \`${gameId}\`\n\nBot အသုံးပြုနိုင်ပါပြီ။`, mainKeyboard(true, isAdmin(id)));
    } catch (e) {
      u.state = "LOGIN_PHONE";
      persist();
      return reply(ctx, `${icon("error")} Login API Error: ${e.message}`);
    }
  }

  if (u.state === "PREDICT_INPUT") {
    const match = text.match(/^\s*([0-9])\s*,\s*([0-9])\s*$/);
    if (!match) return reply(ctx, `${icon("error")} Format မမှန်ပါ။ <code>0,2</code> ပုံစံဖြင့် ထည့်ပါ။`);
    const oldN = Number(match[1]), newN = Number(match[2]);
    const gameKey = u.selectedGame;
    const records = resultStore[gameKey] || [];
    if (records.length < 1) return reply(ctx, `${icon("loading")} ${GAME[gameKey].name} Data မရသေးပါ။ ခဏစောင့်ပြီး ပြန်စမ်းပါ။`);
    const pred = predict(records, oldN, newN);

    let nextPeriod = null;
    try {
      const session = axios.create({
        baseURL: API_BASE_URL,
        timeout: 15000,
        headers: apiHeaders(u.sessionTokenHeader, u.sessionToken),
        validateStatus: () => true
      });
      nextPeriod = await fetchLatestIssue(session, gameKey);
    } catch {}

    const predId = `${id}_${Date.now()}_${crypto.randomBytes(4).toString("hex")}`;
    predictions[predId] = {
      telegramId: id,
      game: gameKey,
      inputOld: oldN,
      inputNew: newN,
      prediction: pred.prediction,
      predictedPeriod: nextPeriod,
      createdAt: new Date().toISOString(),
      status: "PENDING",
      stats: {
      counts: pred.stats?.counts || Array(10).fill(0),
      pct: pred.stats?.counts
        ? pred.stats.counts.map(n =>
            pred.stats.total > 0
              ? Number(((n / pred.stats.total) * 100).toFixed(2))
              : 0
          )
        : Array(10).fill(0),
      bigPct: pred.stats?.total > 0
        ? Number(((pred.stats.big / pred.stats.total) * 100).toFixed(2))
        : 0,
      smallPct: pred.stats?.total > 0
        ? Number(((pred.stats.small / pred.stats.total) * 100).toFixed(2))
        : 0,
      sample: pred.matched || 0
    }
    };
    u.state = null;
    persist();

    await reply(ctx, 
      predictionMessage(gameKey, oldN, newN, pred, nextPeriod, records.length),
      winLoseKeyboard(predId)
    );
    return;
  }

  if (isAdmin(id) && u.state === "ADMIN_ADD") {
    const target = text.replace(/\D/g, "");
    if (!target) return reply(ctx, `${icon("error")} Valid Telegram User ID ထည့်ပါ။`, adminKeyboard());
    allowedIds.add(target);
    u.state = null;
    persist();
    return reply(ctx, `${icon("success")} User ထည့်ပြီးပါပြီ။\nID: \`${target}\``, adminKeyboard());
  }

  if (isAdmin(id) && u.state === "ADMIN_REMOVE") {
    const target = text.replace(/\D/g, "");
    if (!target) return reply(ctx, `${icon("error")} Valid Telegram User ID ထည့်ပါ။`, adminKeyboard());
    const existed = allowedIds.delete(target);
    u.state = null;
    persist();
    return reply(ctx, `${existed ? icon("success") + " User ဖယ်ပြီးပါပြီ။" : icon("error") + " ဒီ ID မရှိပါ။"}\nID: \`${target}\``, adminKeyboard());
  }

  if (isAdmin(id) && u.state === "ADMIN_BROADCAST") {
    u.state = null;
    let ok = 0, fail = 0;
    for (const target of [...allowedIds]) {
      try {
        await sendMessage(target, `${icon("broadcast")} ${escapeHtml(text)}`);
        ok++;
      } catch { fail++; }
      await new Promise(r => setTimeout(r, 80));
    }
    persist();
    return reply(ctx, `${icon("success")} Broadcast ပြီးပါပြီ။\n\n✅ Sent: ${ok}\n❌ Failed: ${fail}`, adminKeyboard());
  }

  // If a user types plain text after selecting a game, don't accidentally mix games.
  if (isAllowed(id) && !u.state) {
    return reply(ctx, `${icon("input")} Predict လုပ်ရန် <b>Predict</b> ကိုနှိပ်ပြီး ` +
      `နောက်ဆုံး result နှစ်လုံးကို old → new <code>0,2</code> ပုံစံဖြင့် ထည့်ပါ။`,
      mainKeyboard(true, isAdmin(id))
    );
  }
});

